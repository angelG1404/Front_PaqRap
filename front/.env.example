# true: datos simulados en el navegador (sin backend). false: usa el backend real.
VITE_USE_MOCK=false
# Vacías: REST y WebSocket usan el mismo origen de la página (recomendado).
# Solo si el front y el back se despliegan en dominios distintos:
#   VITE_API_URL=https://mi-back.example.com
#   VITE_WS_URL=wss://mi-back.example.com/ws
VITE_API_URL=
VITE_WS_URL=
# Backend al que el servidor de desarrollo de Vite reenvía /api y /ws.
VITE_BACKEND_URL=http://localhost:8081
VITE_MOCK_FIN_TICKS=90
